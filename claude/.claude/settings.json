{
  "permissions": {
    "additionalDirectories": ["~/.claude"],
    "allow": [
      "Read(./)",
      "Write(./)",

      "Bash(ls *)",
      "Bash(head *)",
      "Bash(cat *)",
      "Bash(grep*)",
      "Bash(find*)",
      "Bash(jq*)",

      "Bash(curl *)",
      "WebFetch(domain:*)",
      
      "Bash(git status*)",
      "Bash(git push)",

      "Bash(python3 *)",
      "Bash(go *)"
    ],
    "deny": [
      "Read(.env*)",

      "Read(../)",
      "Write(../)",
      "Read(/)",
      "Write(/)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(sudo *)",
      
      "Bash(git push:*)",
      "Bash(git force-push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/guard_git_push.py" }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/block_secrets.py" },
          { "type": "command", "command": "python3 ~/.claude/hooks/protect_files.py" }
        ]
      }
    ]
  }
}
